[resource]
script = ExtResource("1_q")
id = "q04_culpa"
topic = "duelo"
text = "Después de una pérdida, mucha gente siente culpa aunque no haya hecho nada malo. Eso es…"
options = PackedStringArray("Una reacción frecuente del duelo que conviene hablar con alguien", "La prueba de que realmente hizo algo mal", "Algo que hay que ocultar", "La señal de que el duelo ya terminó")
correct_index = 0
explanation = "La culpa es común en el duelo. Ponerla en palabras con alguien de confianza ayuda a aliviarla."
