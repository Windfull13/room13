[resource]
script = ExtResource("1_q")
id = "q02_espectadores"
topic = "acoso"
text = "Si ves que molestan a un compañero una y otra vez, ¿qué ayuda más?"
options = PackedStringArray("Apoyarlo y avisar a un adulto de confianza", "Mirar y no meterte para evitar problemas", "Grabarlo y compartirlo", "Esperar a que se solucione solo")
correct_index = 0
explanation = "Quien mira y calla también influye. Apoyar a la víctima y avisar a un adulto ayuda a frenarlo."
