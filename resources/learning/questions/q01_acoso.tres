script = ExtResource("1_q")
id = "q01_acoso"
topic = "acoso"
text = "¿Qué describe mejor el acoso escolar?"
options = PackedStringArray("Agresiones o humillaciones repetidas hacia alguien que no puede defenderse con facilidad", "Una pelea aislada entre dos amigos", "Bromas que siempre son inofensivas", "Un problema que desaparece al terminar la escuela")
correct_index = 0
explanation = "El acoso es repetido e intencionado, y sus efectos pueden durar años."
